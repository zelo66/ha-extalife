{
  "entity": {
    "extalife": {
      "controller": {
        "default": "mdi:cube-outline",
        "state": {
          "ready": "mdi:cube-outline",
          "connected": "mdi:cube-scan",
          "disconnected": "mdi:cube-off-outline"
        }
      }
    },
    "update": {
      "extalife": {
        "default": "mdi:chip"
      }
    },
    "event": {
      "scene": {
        "default": "mdi:palette"
      }
    },
    "sensor": {
      "controller_ip": {
        "default": "mdi:ip-network"
      },
      "controller_response_time": {
        "default": "mdi:timer-outline"
      }
    }
  },
  "services": {
    "config_backup": "mdi:archive-arrow-down",
    "restart": "mdi:restart",
    "refresh_state": "mdi:sync",
    "test_button": "mdi:button-pointer",
    "record_traffic": "mdi:record-rec"
  }
